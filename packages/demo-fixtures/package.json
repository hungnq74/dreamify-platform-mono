{
  "name": "@dreamify/demo-fixtures",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": ["dist", "data"],
  "scripts": {
    "prebuild": "npm run build --workspace @dreamify/contracts && npm run build --workspace @dreamify/workflow",
    "build": "tsc -p tsconfig.json",
    "lint": "tsc -p tsconfig.json --noEmit",
    "pretest": "npm run build --workspace @dreamify/contracts && npm run build --workspace @dreamify/workflow",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@dreamify/contracts": "0.1.0",
    "@dreamify/workflow": "0.1.0"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  }
}
