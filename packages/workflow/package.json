{
  "name": "@dreamify/workflow",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./testing": {
      "types": "./dist/testing/memory.d.ts",
      "default": "./dist/testing/memory.js"
    }
  },
  "scripts": {
    "prebuild": "npm run build --workspace @dreamify/contracts",
    "build": "tsc -p tsconfig.json",
    "prelint": "npm run build --workspace @dreamify/contracts",
    "lint": "tsc -p tsconfig.json --noEmit",
    "pretest": "npm run build --workspace @dreamify/contracts",
    "pretypecheck": "npm run build --workspace @dreamify/contracts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@dreamify/contracts": "0.1.0",
    "@vercel/sandbox": "3.0.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  }
}
